# Copy this file to ".env.local" to change the defaults. All values are optional.

# The website calls the API at /api on its own address. While developing on your
# computer, Next.js forwards those calls to the backend at this address:
BACKEND_URL=http://localhost:4000

# Only if the backend is deployed on a different domain than the website
# (not needed with the vercel.json in this repository):
# NEXT_PUBLIC_API_URL=https://your-backend.example.com
