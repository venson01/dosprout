# Copy this file to ".env" to change the defaults. All values are optional.

# Port the API listens on
PORT=4000
# Use 0.0.0.0 to allow other devices on your network to connect
HOST=localhost
# Where the database is. By default it's a file on this computer (relative to the
# backend folder). On Vercel, use your Turso database URL, e.g. libsql://todos-you.turso.io
TURSO_DATABASE_URL=file:data/todos.db
# Only needed for a Turso cloud database (create one with: turso db tokens create <name>)
TURSO_AUTH_TOKEN=
# The frontend URL(s) allowed to call the API, comma-separated
CORS_ORIGIN=http://localhost:3000
# How much the server logs: fatal, error, warn, info, debug, trace
LOG_LEVEL=info
