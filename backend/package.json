{
  "name": "dosprout-backend",
  "version": "0.1.0",
  "description": "Fastify + SQLite (Turso) API for the DoSprout todo app",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "copy-to-turso": "tsx --env-file-if-exists=.env src/scripts/copy-to-turso.ts"
  },
  "type": "module",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@libsql/client": "^0.18.0",
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=22.13"
  }
}
